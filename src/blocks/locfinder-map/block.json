{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "locfinder/locfinder-map",
	"title": "Location Finder Map",
	"category": "widgets",
	"icon": "location-alt",
	"description": "A block that displays a Location Finder map with search functionality.",
	"supports": {
		"html": false
	},

	"attributes": {
		"keywordSearch": { "type": "boolean", "default": true },
		"addressSearch": { "type": "boolean", "default": true },
		"radiusSearch": { "type": "boolean", "default": true },
		"categorySearch": { "type": "boolean", "default": true },
		"defaultRadius": { "type": "number", "default": -1 },
		"keywordPlaceholder": { "type": "string", "default": "" },
		"addressPlaceholder": { "type": "string", "default": "" },
		"searchButtonLabel": { "type": "string", "default": "" },
		"radiusLabel": { "type": "string", "default": "" },
		"categoryLabel": { "type": "string", "default": "" },
		"anyDistanceText": { "type": "string", "default": "" },
		"allCategoriesText": { "type": "string", "default": "" },
		"sortBy": { "type": "string", "default": "default" },
		"resultsLayout": { "type": "string", "default": "default" },
		"resultsPosition": { "type": "string", "default": "default" },
		"gridCols": { "type": "number", "default": 3 },
		"resultsColumns": { "type": "number", "default": 0 },
		"postsPerPage": { "type": "number", "default": 0 },
		"pinColor": { "type": "string", "default": "" },
		"showImage": { "type": "boolean", "default": false },
		"showAddress": { "type": "boolean", "default": true },
		"showDirections": { "type": "boolean", "default": true },
		"showPhone": { "type": "boolean", "default": true },
		"showEmail": { "type": "boolean", "default": false },
		"showWebsite": { "type": "boolean", "default": true },
		"showHours": { "type": "boolean", "default": false },
		"showExcerpt": { "type": "boolean", "default": false },
		"showOpenBadge": { "type": "boolean" },
		"showCategories": { "type": "boolean", "default": true },
		"taxonomy": { "type": "string", "default": "" }
	},
	"textdomain": "locfinder",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
