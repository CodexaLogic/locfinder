{
	"name": "locfinder",
	"version": "1.1.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20",
		"npm": ">=10"
	},
	"scripts": {
		"dev": "concurrently -n vite,blocks -c blue,green \"npm:dev:vite\" \"npm:dev:blocks\"",
		"dev:vite": "vite build --watch",
		"dev:blocks": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks",
		"build": "npm run build:vite && npm run build:blocks",
		"build:vite": "node scripts/clean-assets.mjs && vite build",
		"build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks",
		"bundle": "npm run build && node scripts/bundle.mjs",
		"prebundle": "find . -path ./node_modules -prune -o -name '.DS_Store' -exec rm -f {} +",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"concurrently": "^9.1.0",
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/block-editor": "^14.0.0",
		"@wordpress/blocks": "^14.0.0",
		"@wordpress/components": "^27.0.0",
		"@wordpress/compose": "^7.0.0",
		"@wordpress/data": "^10.0.0",
		"@wordpress/element": "^6.0.0",
		"@wordpress/eslint-plugin": "^25.4.0",
		"@wordpress/i18n": "^5.0.0",
		"@wordpress/scripts": "^30.0.0",
		"archiver": "^7.0.1",
		"eslint": "^9.39.1",
		"globals": "^17.6.0",
		"prettier": "^3.7.4",
		"sass": "^1.93.2",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@googlemaps/markerclusterer": "^2.6.2"
	}
}
