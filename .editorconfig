root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Markdown uses trailing whitespace as a hard line break.
[*.md]
trim_trailing_whitespace = false

# YAML tooling (including GitHub Actions) conventionally expects
# 2-space indentation, not tabs.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# gettext-managed catalogs; leave formatting to the toolchain.
[*.{po,pot}]
insert_final_newline = false
trim_trailing_whitespace = false
